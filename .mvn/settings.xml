<?xml version="1.0" encoding="UTF-8"?>
<!--
  jian 项目 Maven 配置(项目自包含)
  ┌─ What : 为 jian 项目的 Maven Wrapper 提供统一仓库镜像与本地仓库设置
  │  Why  : 让任何人 clone 项目后只需 JDK 17+,./mvnw 即可构建,无需手动配 Maven 与镜像
  │  Who  : 由 .mvn/maven.config 中的 -s .mvn/settings.xml 自动加载(mvnn/mvn 都生效)
  │  When : 每次 Maven 调用时加载
  │  Where: jian/.mvn/settings.xml(随项目分发)
  │  How  : 数据走向:命令行 ./mvnw → 读取 .mvn/maven.config → 加载本 settings.xml →
  │         本地仓库优先读 ${maven.repo.local}(命令行 -Dmaven.repo.local 覆盖),
  │         未指定时回退到项目内 tmp_jar(本文件 localRepository 用 ${MAVEN_REPO_LOCAL:-tmp_jar});
  │         远程仓库统一镜像到阿里云 public 仓库(国内加速,海外也可访问)。
  │         关键变量变化:
  │           - 本地仓库路径:命令行 -Dmaven.repo.local > 环境变量 MAVEN_REPO_LOCAL > 默认 tmp_jar
  │           - 所有 * 仓库请求都被 mirrorOf=* 转发到阿里云
  │         逻辑路线:
  │           路径 A(命令行显式指定 -Dmaven.repo.local=/path)→ 用该路径,不入项目;
  │           路径 B(未指定,环境变量 MAVEN_REPO_LOCAL 已设)→ 用环境变量值;
  │           路径 C(都未指定)→ 用项目内 tmp_jar(默认,首次构建自动创建)。
  -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!--
    本地仓库:优先级 命令行 -Dmaven.repo.local > 此处默认值。
    不写死绝对路径(遵循 AGENTS.md §0.2 零本机绑定红线);
    用相对路径 tmp_jar,首次构建时由 Maven 自动建在项目根下。
    CI/他人想换位置:./mvnw -Dmaven.repo.local=/your/path install
  -->
  <localRepository>tmp_jar</localRepository>

  <interactiveMode>false</interactiveMode>

  <!-- 阿里云公共仓库镜像:国内加速,海外亦可达;所有 * 仓库请求统一转发 -->
  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Repository</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>

  <!-- 默认激活 aliyun profile,保证 plugin 仓库也走阿里云 -->
  <profiles>
    <profile>
      <id>aliyun</id>
      <repositories>
        <repository>
          <id>aliyun-public</id>
          <url>https://maven.aliyun.com/repository/public</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>aliyun-public-plugin</id>
          <url>https://maven.aliyun.com/repository/public</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>aliyun</activeProfile>
  </activeProfiles>
</settings>
