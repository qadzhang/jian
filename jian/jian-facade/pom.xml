         若要按需加载,用户可改为只引具体 io 子模块(规范 §4.2)。-->
    <dependency><groupId>jian</groupId><artifactId>jian-core</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-csv</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-json</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-excel</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-html</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-xml</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-sql</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-parquet</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-orc</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-pickle</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-clipboard</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-io-latex</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-export</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-viz</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-dsl</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-sql-engine</artifactId></dependency>
    <dependency><groupId>jian</groupId><artifactId>jian-sql-bridge</artifactId></dependency>
    <!-- 测试 -->
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
